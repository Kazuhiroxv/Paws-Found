node_modules
dist
dist-ssr
*.local

# Env files — no secrets belong in this repository
.env
.env.*
!.env.example

# The deployed API's real database credentials. config.example.php is the
# template and IS tracked; the filled-in copy never is.
api/config.local.php

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploaded photographs are user data, not source. The folder and its rules are
# tracked; what people upload into it is not.
api/uploads/*
!api/uploads/.htaccess

# Python bytecode from the audit scripts
__pycache__/
scripts/.local/
