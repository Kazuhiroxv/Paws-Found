{
  "name": "paws-and-found",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Paws&Found — Web-Based Community System for Lost and Found Pets",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/bundle-check.mjs",
    "build:deploy": "node scripts/build-deploy.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "a11y": "node scripts/a11y.mjs",
    "audit": "python scripts/audit_cases.py",
    "test:mail": "php scripts/mail_transport.php",
    "multi-device": "python scripts/multi_device.py",
    "test:signout": "node scripts/signout_privacy.mjs",
    "test:ui": "node scripts/ui_regressions.mjs",
    "test:feedback": "node scripts/form_feedback.mjs",
    "test:matching-log": "php scripts/matching_log.php",
    "test:calendar": "php scripts/calendar_today.php",
    "test:city": "php scripts/city_fallback.php",
    "test:identity": "php scripts/identity_rules.php",
    "test:report-rules": "php scripts/report_rules.php",
    "test:scores": "php scripts/match_scores.php",
    "test:controls": "python scripts/report_controls.py",
    "test:report-ui": "node scripts/report_ui.mjs",
    "check:psgc": "python scripts/psgc_reference.py check",
    "test:migrations": "python scripts/migration_parity.py",
    "verify:deploy": "python scripts/verify_deployment.py",
    "test:contract": "node --import ./scripts/alias-hook.mjs --test scripts/*.test.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "puppeteer-core": "^24.28.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
